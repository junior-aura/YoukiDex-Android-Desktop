<?xml version="1.0" encoding="utf-8"?>
<!-- ClauDEX task switcher: the open windows, pick = bring to front, X = close -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:background="@drawable/round_rect"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/switcher_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="8dp"
        android:text="@string/switcher_title"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/switcher_lv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null" />

    <TextView
        android:id="@+id/switcher_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/switcher_empty"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/switcher_tile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle"
            android:contentDescription="@string/tile_windows"
            android:padding="10dp"
            android:src="@drawable/ic_tile_windows" />

        <ImageView
            android:id="@+id/switcher_expand"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle"
            android:contentDescription="@string/expand_window"
            android:padding="10dp"
            android:src="@drawable/ic_maximized" />
    </LinearLayout>
</LinearLayout>
